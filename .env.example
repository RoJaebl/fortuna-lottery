# 로컬 Postgres (docker-compose.yml의 자격증명과 일치해야 한다)
# 이 값을 그대로 apps/api/.env 에 넣는다 — DB 를 읽고 쓰는 것은 apps/api 뿐이다. apps/api 는 기동할 때 그 파일을 스스로 싣는다
DATABASE_URL="postgresql://fortuna:fortuna_local@localhost:5432/fortuna_lottery?schema=public"

# apps/api 의 회차 수집 스케줄러 — 적지 않으면 `dev` 에서는 꺼짐, `start` 에서는 켜짐(동행복권 원격을 부른다).
# 적으면 그 값이 이긴다: dev 에서 수집하려면 true, start 에서 끄려면 false
# SCHEDULER_ENABLED=true

# 포트는 런처(tools/launch/launch.mjs)가 고른다 — .claude/context/launcher-ports.md
# pnpm dev   : 화면 3000·서버 4000 에서 시작해 쥐여 있으면 하나씩 올린다. 셸의 PORT·HOST 는 자식에 넘기지 않는다
# pnpm start : 아래 둘을 적으면 그 번호에 고정으로 선다(쥐여 있으면 실패한다). 적지 않으면 OS 가 준 빈 포트
#              이 둘은 apps/api/.env 가 아니라 pnpm start 를 부르는 셸의 환경에 둔다
# FORTUNA_WEB_PORT=3000
# FORTUNA_API_PORT=4000
# 런처가 서버에 넘기는 값(손으로 적지 않는다): PORT · FORTUNA_STRICT_PORT=1 · FORTUNA_MODE=dev|start, 화면에는 PORT · API_ORIGIN
