{
  "name": "fortuna-lottery",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "node tools/launch/launch.mjs dev",
    "start": "node tools/launch/launch.mjs start",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:tools": "node --test \"tools/launch/*.test.mjs\"",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:deps": "pnpm --filter @fortuna-lottery/web exec store-gen && depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:side-effects": "node tools/checks/no-side-effects-false.mjs apps/web/package.json",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm lint:side-effects && pnpm test && pnpm test:tools",
    "check:migration": "bash tools/checks/migration-status.sh"
  },
  "devDependencies": {
    "supa-store": "github:RoJaebl/supa-store#1419b7a0ad65b37dd583da61553a68a34864621f",
    "dependency-cruiser": "^18.4.0",
    "turbo": "^2.5.0"
  }
}
