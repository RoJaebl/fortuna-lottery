// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`store > store 에 등록된 전부 1`] = `
"[state]
state.home.combination = null
  정의: app/(home)/_state/combination.state.ts
  바꾸는 함수: choose
  읽는 곳: HypothesisLab, PicksCard, SimulationCard, StatisticsPanel
  바꾸는 곳: GeneratorCard, HypothesisLab
state.home.generatorOpen = false
  정의: app/(home)/_state/generatorOpen.state.ts
  바꾸는 함수: toggle
  읽는 곳: Home, LotterietusCard
  바꾸는 곳: LotterietusCard
[cache]
cache.hypothesis.popularity
cache.lotterietus.status
cache.picks.list
cache.results.check
cache.statistics.get
[http]
http.generator.generate
http.hypothesis.evaluate
http.hypothesis.generate
http.picks.delete
http.picks.save
http.simulation.backtest
[event]
event.picks.removed (from: tab)
  낡게 한다: cache.picks.list (from: tab)
  일부러 낡게 하지 않는다: cache.results.check — 결과는 사람이 「당첨 대조」를 눌러 받는다
event.picks.saved (from: tab)
  낡게 한다: cache.picks.list (from: tab)
  일부러 낡게 하지 않는다: cache.results.check — 결과는 사람이 「당첨 대조」를 눌러 받는다
[route]
route.home.index"
`;
