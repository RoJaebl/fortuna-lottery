    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "prisma": "6.19.3",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@fortuna-lottery/contract": "workspace:*",
    "@prisma/client": "6.19.3"
  }
}
